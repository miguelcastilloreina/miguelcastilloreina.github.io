---
import Base from '../layouts/Base.astro';
import Contours from '../components/Contours.astro';
import PubItem from '../components/PubItem.astro';
import { profile, projects, publications, inline, url } from '../lib/data';

const selected = publications.filter((p) => p.selected);
const cur = projects.current;
---
<Base>
  <div class="hero">
    <Contours />
    <div class="wrap hero-grid">
      <div class="hero-text">
        <div class="label">{profile.position.replace('PhD candidate in ', 'PhD candidate · ')}</div>
        <h1>{profile.name}</h1>
        <p class="tagline" set:html={inline(profile.tagline)} />
        <div class="meta">
          <span>{profile.institution}</span>
          <span>{profile.location}</span>
        </div>
      </div>
      <img class="portrait" src={url('/img/portrait.jpg')} alt={`Portrait of ${profile.name}`} width="560" height="560" />
    </div>
  </div>

  <div class="wrap">
    <section class="block about">
      <aside class="facts">
        <div>
          <div class="label">Education</div>
          <ul class="plain edu">
            {profile.education.map((e: any) => (
              <li><span>{e.degree}</span><small>{e.place} · {e.years}</small></li>
            ))}
          </ul>
        </div>
        <div>
          <div class="label">Interests</div>
          <ul class="plain tags">
            {profile.interests.map((t: string) => <li>{t}</li>)}
          </ul>
        </div>
        <div>
          <div class="label">Languages</div>
          <p class="lang">{profile.languages}</p>
        </div>
      </aside>
      <div class="prose">
        {profile.bio.map((p: string) => <p set:html={inline(p)} />)}
        <a class="more" href={url('/cv')}>Full CV</a>
      </div>
    </section>

    <section class="block">
      <div class="block-head">
        <div class="label">Current work</div>
        <h2>What I am working on</h2>
      </div>
      <article class={`feature${cur.image ? ' has-img' : ''}`}>
        <div class="feature-text">
          <span class="status">{cur.label}</span>
          <h3>{cur.title}</h3>
          <p set:html={inline(cur.summary)} />
          <a class="more" href={url('/projects')}>Research lines</a>
        </div>
        {cur.image && (
          <img src={url(`/img/${cur.image}`)} alt={cur.image_alt} loading="lazy" />
        )}
      </article>
    </section>

    <section class="block">
      <div class="block-head">
        <div class="label">Research</div>
        <h2>Selected publications</h2>
      </div>
      <div>
        {selected.map((p) => <PubItem pub={p} />)}
      </div>
      <a class="more" href={url('/research')}>All publications</a>
    </section>

    <section class="block">
      <div class="block-head">
        <div class="label">News</div>
        <h2>Recent</h2>
      </div>
      <ul class="plain rows">
        {profile.news.map((n: any) => (
          <li><span class="when">{n.date}</span><span set:html={inline(n.text)} /></li>
        ))}
      </ul>
    </section>
  </div>
</Base>

<style>
  .hero { position: relative; overflow: hidden; border-bottom: 1px solid var(--line); }
  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 240px;
    gap: 48px;
    align-items: center;
    padding-block: 80px 72px;
  }
  .hero h1 { font-size: var(--step-3); margin-top: 14px; }
  .tagline { font-size: var(--step-1); line-height: 1.45; margin-top: 18px; max-width: 34ch; }
  .tagline :global(b) { color: var(--accent); }
  .meta { display: flex; flex-wrap: wrap; gap: 6px 22px; margin-top: 22px; color: var(--muted); font-size: 0.95rem; }
  .portrait {
    width: 240px; aspect-ratio: 1; object-fit: cover; border-radius: 50%;
    border: 6px solid var(--bg); box-shadow: 0 0 0 1px var(--line);
    justify-self: end;
  }
  @media (max-width: 760px) {
    .hero-grid { grid-template-columns: 1fr; gap: 28px; padding-block: 44px 48px; }
    .portrait { width: 136px; justify-self: start; order: -1; }
  }

  .about { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: 48px; }
  .prose { max-width: 64ch; display: grid; gap: 1em; align-content: start; }
  .prose .more { margin-top: 4px; justify-self: start; }
  .facts { display: grid; gap: 24px; align-content: start; font-size: 0.94rem; }
  .edu { display: grid; gap: 10px; margin-top: 8px; }
  .edu li { display: grid; line-height: 1.4; }
  .edu small { color: var(--muted); font-size: 0.85rem; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
  .tags li { font-size: 0.82rem; padding: 3px 10px; border-radius: 99px; background: var(--surface); }
  .lang { margin-top: 8px; }
  @media (max-width: 760px) {
    .about { grid-template-columns: 1fr; gap: 32px; }
    .facts { order: 2; }
  }

  .feature {
    display: grid; grid-template-columns: 1fr;
    background: var(--surface); border-radius: 6px; overflow: hidden;
  }
  .feature.has-img { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); }
  .feature-text { padding: 32px; max-width: 72ch; }
  .feature .status { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--second); }
  .feature h3 { font-size: 1.6rem; margin: 10px 0 12px; }
  .feature img { width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 760px) {
    .feature.has-img { grid-template-columns: 1fr; }
    .feature-text { padding: 24px; }
  }
</style>
