---
import Base from '../layouts/Base.astro';
import { activity } from '../lib/data';

const talks = activity.talks ?? [];
---
<Base title="Activity" description="Talks, awards and affiliations of Miguel Ángel Castillo-Reina.">
  <div class="page-head">
    <div class="wrap">
      <div class="label">Activity</div>
      <h1>{talks.length ? 'Talks, awards and affiliations' : 'Awards and affiliations'}</h1>
    </div>
  </div>

  <div class="wrap">
    {talks.length > 0 && (
      <section class="block">
        <div class="block-head"><div class="label">Talks</div><h2>Presentations</h2></div>
        <ul class="plain rows">
          {talks.map((t: any) => (
            <li>
              <span class="when">{t.date}</span>
              <span>{t.url ? <a href={t.url}>{t.title}</a> : t.title}<small>{t.event}{t.place && ` · ${t.place}`}</small></span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="block two">
      <div>
        <h2>Awards and grants</h2>
        <ul class="plain rows">
          {activity.awards.map((a: any) => (
            <li><span class="when">{a.year}</span><span>{a.title}<small>{a.detail}</small></span></li>
          ))}
        </ul>
      </div>
      <div>
        <h2>Affiliations</h2>
        <ul class="plain rows">
          {activity.affiliations.map((a: any) => (
            <li><span class="when">{a.since}–</span><span>{a.url ? <a href={a.url}>{a.name}</a> : a.name}<small>{a.role}</small></span></li>
          ))}
        </ul>
      </div>
    </section>
  </div>
</Base>

<style>
  .two { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 48px; }
  .two h2 { font-size: 1.5rem; margin-bottom: 14px; }
  @media (max-width: 760px) { .two { grid-template-columns: 1fr; } }
</style>
