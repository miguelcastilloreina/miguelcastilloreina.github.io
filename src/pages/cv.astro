---
import Base from '../layouts/Base.astro';
import { profile, url } from '../lib/data';
---
<Base title="CV" description="Curriculum vitae of Miguel Ángel Castillo-Reina in English and Spanish.">
  <div class="page-head">
    <div class="wrap">
      <div class="label">CV</div>
      <h1>Curriculum vitae</h1>
      <p>The full CV covers education, professional experience in science, technology and innovation policy in Colombia, publications, awards and affiliations.</p>
    </div>
  </div>

  <div class="wrap">
    <section class="block">
      <div class="dl">
        <a class="btn solid" href={url('/cv/castillo-reina-cv-en.pdf')}>CV in English (PDF)</a>
        <a class="btn" href={url('/cv/castillo-reina-cv-es.pdf')} hreflang="es">CV en español (PDF)</a>
      </div>
      <p class="upd">Last updated October 2026.</p>
    </section>

    <section class="block">
      <div class="block-head"><div class="label">Education</div><h2>Degrees</h2></div>
      <ul class="plain rows">
        {profile.education.map((e: any) => (
          <li><span class="when">{e.years}</span><span>{e.degree}<small>{e.place}</small></span></li>
        ))}
      </ul>
    </section>
  </div>
</Base>

<style>
  .dl { display: flex; flex-wrap: wrap; gap: 12px; }
  .upd { margin-top: 14px; color: var(--muted); font-size: 0.9rem; }
</style>
