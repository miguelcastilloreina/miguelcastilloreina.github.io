---
import Base from '../layouts/Base.astro';
import { projects, publications, inline, url } from '../lib/data';

const cur = projects.current;
const lines = projects.lines.map((l: any) => ({
  ...l,
  pubs: publications.filter((p) => p.line === l.id),
}));
---
<Base title="Projects" description="Doctoral research and research lines of Miguel Ángel Castillo-Reina.">
  <div class="page-head">
    <div class="wrap">
      <div class="label">Projects</div>
      <h1>Research lines</h1>
      <p>My doctoral project on visual tourist attractions, and the questions on territory and development I keep coming back to.</p>
    </div>
  </div>

  <div class="wrap">
    <section class="block">
      <article class={`current${cur.image ? ' has-img' : ''}`}>
        <div>
          <span class="status">{cur.label}</span>
          <h2>{cur.title}</h2>
          <p set:html={inline(cur.summary)} />
        </div>
        {cur.image && <img src={url(`/img/${cur.image}`)} alt={cur.image_alt} loading="lazy" />}
      </article>
    </section>

    <section class="block">
      <ul class="plain lines">
        {lines.map((l: any) => (
          <li id={l.id}>
            <div class="when">{l.period}</div>
            <div class="body">
              <h3>{l.title}</h3>
              <p set:html={inline(l.text)} />
              {l.pubs.length > 0 && (
                <ul class="plain related">
                  {l.pubs.map((p: any) => (
                    <li><span class="mono">{p.year}</span> <span set:html={inline(p.title)} /></li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>

<style>
  .current { display: grid; gap: 32px; }
  .current.has-img { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: center; }
  .current .status { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--second); }
  .current h2 { font-size: var(--step-2); margin: 10px 0 14px; max-width: 24ch; }
  .current p { max-width: 64ch; }
  .current img { border-radius: 6px; }
  @media (max-width: 760px) { .current.has-img { grid-template-columns: 1fr; } }

  .lines > li { display: grid; grid-template-columns: 72px minmax(0, 1fr); gap: 16px; padding: 24px 0; border-top: 1px solid var(--line); }
  .lines > li:first-child { border-top: 0; padding-top: 0; }
  .when { font-family: var(--font-mono); font-size: 0.82rem; color: var(--muted); padding-top: 6px; }
  .body h3 { font-size: 1.35rem; margin-bottom: 8px; }
  .body p { max-width: 64ch; }
  .related { margin-top: 12px; display: grid; gap: 6px; font-size: 0.92rem; color: var(--muted); }
  .related .mono { font-size: 0.8rem; margin-right: 6px; }
  @media (max-width: 480px) { .lines > li { grid-template-columns: 1fr; gap: 4px; } }
</style>
