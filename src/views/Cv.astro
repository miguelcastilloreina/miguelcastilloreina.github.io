---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { profile, url, tr, type Lang } from '../lib/data';
import { ui } from '../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const files = [
  { l: 'en', label: t.cv.en, file: '/cv/castillo-reina-cv-en.pdf' },
  { l: 'es', label: t.cv.es, file: '/cv/castillo-reina-cv-es.pdf' },
];
// El CV del idioma de la página va primero y destacado.
files.sort((a, b) => (a.l === lang ? -1 : b.l === lang ? 1 : 0));
---
<Base lang={lang} route="cv" title={t.cv.title} description={t.cv.metaDesc}>
  <div class="page-head">
    <div class="wrap">
      <div class="label">{t.cv.label}</div>
      <h1>{t.cv.title}</h1>
      <p>{t.cv.intro}</p>
    </div>
  </div>

  <div class="wrap">
    <section class="block">
      <div class="dl">
        {files.map((f, i) => (
          <a class:list={['btn', { solid: i === 0 }]} href={url(f.file)} hreflang={f.l}><Icon name="download" />{f.label}</a>
        ))}
      </div>
      <p class="upd">{t.cv.updated}</p>
    </section>

    <section class="block">
      <div class="block-head"><div class="label">{t.education}</div><h2>{t.cv.degrees}</h2></div>
      <ul class="plain rows">
        {profile.education.map((e: any) => (
          <li><span class="when">{e.years}</span><span>{tr(e.degree, lang)}<small>{tr(e.place, lang)}</small></span></li>
        ))}
      </ul>
    </section>
  </div>
</Base>

<style>
  .dl { display: flex; flex-wrap: wrap; gap: 12px; }
  .dl .btn { display: inline-flex; align-items: center; gap: 8px; }
  .upd { margin-top: 14px; color: var(--muted); font-size: 0.9rem; }
</style>
