---
import Base from '../layouts/Base.astro';
import PubItem from '../components/PubItem.astro';
import { publications, type Lang, type Publication } from '../lib/data';
import { ui } from '../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const order: Publication['type'][] = ['article', 'working', 'chapter', 'book', 'policy'];
const groups = order
  .map((type) => ({ type, label: t.groups[type][0], short: t.groups[type][1], items: publications.filter((p) => p.type === type) }))
  .filter((g) => g.items.length);
---
<Base lang={lang} route="research" title={t.nav.research} description={t.research.metaDesc}>
  <div class="page-head">
    <div class="wrap">
      <div class="label">{t.nav.research}</div>
      <h1>{t.research.title}</h1>
      <p>{t.research.intro}</p>
    </div>
  </div>

  <div class="wrap">
    <div class="filters" role="group" aria-label={t.research.filter} hidden>
      <button type="button" data-k="all" aria-pressed="true">{t.research.all} <span class="n">{publications.length}</span></button>
      {groups.map((g) => (
        <button type="button" data-k={g.type} aria-pressed="false">{g.short} <span class="n">{g.items.length}</span></button>
      ))}
    </div>

    {groups.map((g) => (
      <section class="group" data-group={g.type}>
        <h2 class="label">{g.label}</h2>
        {g.items.map((p) => <PubItem pub={p} lang={lang} />)}
      </section>
    ))}
  </div>
</Base>

<style>
  .filters { display: flex; flex-wrap: wrap; gap: 8px; padding-top: 36px; }
  .filters button {
    font: inherit; font-size: 0.9rem; cursor: pointer;
    padding: 6px 14px; border-radius: 99px;
    border: 1px solid var(--line); background: transparent; color: var(--muted);
  }
  .filters button[aria-pressed='true'] { background: var(--ink); border-color: var(--ink); color: var(--bg); }
  .filters .n { font-family: var(--font-mono); font-size: 0.75rem; opacity: 0.75; margin-left: 2px; }
  .group { padding-top: 40px; }
  .group h2 { font-family: var(--font-body); letter-spacing: 0.1em; margin-bottom: 8px; }
  .group:last-of-type { padding-bottom: 32px; }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('.filters');
  if (bar) {
    bar.hidden = false;
    const groups = document.querySelectorAll<HTMLElement>('.group');
    bar.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest('button');
      if (!b) return;
      const k = b.dataset.k;
      bar.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      groups.forEach((g) => { g.hidden = k !== 'all' && g.dataset.group !== k; });
    });
  }
</script>
