---
import Base from '../layouts/Base.astro';
import PageBanner from '../components/PageBanner.astro';
import Icon from '../components/Icon.astro';
import LineThumb from '../components/LineThumb.astro';
import { projects, publications, inline, tr, pubId, url, type Lang } from '../lib/data';
import { ui, href } from '../lib/i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const cur = projects.current;
const lines = projects.lines.map((l: any) => ({
  ...l,
  pubs: publications.filter((p) => p.line === l.id),
}));
---
<Base lang={lang} route="projects" title={t.nav.projects} description={t.projects.metaDesc}>
  <div class="page-head">
    <div class="wrap">
      <div class="label">{t.projects.label}</div>
      <h1>{t.projects.title}</h1>
      <p>{t.projects.intro}</p>
    </div>
  </div>
  <PageBanner page="projects" lang={lang} />

  <div class="wrap">
    <section class="block">
      <article class="current">
        <LineThumb seed="current-work" image={cur.image} alt={tr(cur.image_alt, lang)} />
        <div>
          <span class="status">{tr(cur.label, lang)}</span>
          <h2>{tr(cur.title, lang)}</h2>
          <p set:html={inline(tr(cur.summary, lang))} />
          {(cur.files ?? []).length > 0 && (
            <ul class="plain downloads">
              {cur.files.map((f: any) => (
                <li>
                  <a class="btn outline" href={url(`/activity/slides/${f.file}`)}><Icon name="download" />{tr(f.label, lang)}</a>
                  {f.note && <span class="dl-note">{tr(f.note, lang)}</span>}
                </li>
              ))}
            </ul>
          )}
        </div>
      </article>
    </section>

    <section class="block">
      <ul class="plain lines">
        {lines.map((l: any) => (
          <li id={l.id}>
            <figure class="lfig">
              <LineThumb seed={l.id} image={l.image} alt={tr(l.image_alt, lang) ?? tr(l.title, lang)} focus={l.focus} />
              {l.credit && <figcaption set:html={inline(tr(l.credit, lang))} />}
            </figure>
            <div class="body">
              <div class="when">{l.period}</div>
              <h3>{tr(l.title, lang)}{l.status && <span class="badge">{tr(l.status, lang)}</span>}</h3>
              <p set:html={inline(tr(l.text, lang))} />
              {l.pubs.length > 0 && (
                <div class="related">
                  <div class="label">{t.projects.related}</div>
                  <ul class="plain">
                    {l.pubs.map((p: any) => (
                      <li>
                        <a href={`${href('research', lang)}#${pubId(p)}`} class="rel-title" set:html={`<span class="mono">${p.year}</span> ${inline(p.title)}`} />
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>

<style>
  .current { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); gap: 36px; align-items: center; }
  .current .status { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--second); }
  .current h2 { font-size: var(--step-2); margin: 10px 0 14px; max-width: 24ch; }
  .current p { max-width: 64ch; }
  .downloads { display: grid; gap: 10px; margin-top: 20px; }
  .downloads li { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; }
  .dl-note { font-size: 0.85rem; color: var(--muted); }
  @media (max-width: 760px) { .current { grid-template-columns: 1fr; gap: 20px; } }

  .lines > li {
    display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: 28px;
    padding: 28px 0; border-top: 1px solid var(--line);
  }
  .lines > li:first-child { border-top: 0; padding-top: 0; }
  .lfig { margin: 0; min-width: 0; }
  .lfig figcaption { font-size: 0.72rem; line-height: 1.35; color: var(--muted); margin-top: 6px; font-style: italic; }
  .when { font-family: var(--font-mono); font-size: 0.82rem; color: var(--muted); }
  .body h3 { font-size: 1.35rem; margin: 4px 0 8px; }
  .body p { max-width: 64ch; }
  .related { margin-top: 16px; }
  .related ul { display: grid; gap: 10px; margin-top: 8px; }
  .related li { padding-left: 14px; border-left: 2px solid var(--line); }
  .rel-title { font-size: 0.92rem; color: var(--ink); text-decoration: none; line-height: 1.4; }
  .rel-title:hover { color: var(--accent); }
  .rel-title :global(.mono) { color: var(--muted); font-size: 0.8rem; margin-right: 4px; }
  @media (max-width: 640px) {
    .lines > li { grid-template-columns: 1fr; gap: 14px; }
    .lfig :global(.lthumb) { aspect-ratio: 16 / 9; }
  }
</style>
