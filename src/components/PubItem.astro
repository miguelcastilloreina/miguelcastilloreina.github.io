---
import type { Publication, Lang } from '../lib/data';
import { inline, authorsHtml, tr, pubId } from '../lib/data';
import { ui } from '../lib/i18n';
import PubThumb from './PubThumb.astro';
import Icon from './Icon.astro';

interface Props { pub: Publication; lang: Lang; thumb?: boolean; abstract?: boolean }
const { pub, lang, thumb = true, abstract = true } = Astro.props;
// Resumen en el idioma de la página; si no existe, el que haya.
const absLang: Lang | undefined = pub.abstract?.[lang] ? lang : pub.abstract?.en ? 'en' : pub.abstract?.es ? 'es' : undefined;
const absText = absLang ? pub.abstract![absLang]! : '';
const absLabel = absLang === lang ? ui[lang].abstract : ui[lang].abstractIn;
const status = tr(pub.status, lang);
const urlLabel = tr(pub.url_label, lang) ?? 'Link';
---
<article class:list={['pub', { 'no-thumb': !thumb }]} id={pubId(pub)} data-type={pub.type}>
  <div class="yr">{pub.year}</div>
  {thumb && <PubThumb pub={pub} lang={lang} />}
  <div class="pub-body">
    <div class="t">
      <Fragment set:html={inline(pub.title)} />
      {status && <span class="badge">{status}</span>}
    </div>
    {pub.authors.length > 0 && <div class="au" set:html={authorsHtml(pub.authors)} />}
    <div class="v" set:html={inline(tr(pub.venue, lang))} />
    {(pub.doi || pub.url || (abstract && absLang)) && (
      <div class="links">
        {pub.doi && <a href={`https://doi.org/${pub.doi}`} title={`https://doi.org/${pub.doi}`}><Icon name="doi" size={14} /><span class="lbl">DOI</span> <span class="doi-id">{pub.doi}</span></a>}
        {pub.url && <a href={pub.url}><Icon name="external" size={14} /><span class="lbl">{urlLabel}</span></a>}
        {abstract && absLang && (
          <button type="button" class="abs-toggle" aria-expanded="false" aria-controls={`${pubId(pub)}-abs`}><span class="lbl">{absLabel}</span></button>
        )}
      </div>
    )}
    {abstract && absLang && (
      <div class="abs-text" id={`${pubId(pub)}-abs`} lang={absLang} hidden>
        {absText.split('\n').map((para) => <p set:html={inline(para)} />)}
      </div>
    )}
  </div>
</article>

<script>
  document.querySelectorAll<HTMLButtonElement>('.abs-toggle').forEach((b) => {
    b.addEventListener('click', () => {
      const box = document.getElementById(b.getAttribute('aria-controls') ?? '');
      if (!box) return;
      const open = b.getAttribute('aria-expanded') !== 'true';
      b.setAttribute('aria-expanded', String(open));
      box.hidden = !open;
    });
  });
</script>
