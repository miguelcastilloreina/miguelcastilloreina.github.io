---
// Foto de paisaje bajo el título de una página interna (configurada en src/data/banners.yaml).
import { banners, url, tr, inline, type Lang } from '../lib/data';
import Icon from './Icon.astro';

interface Props { page: string; lang: Lang }
const { page, lang } = Astro.props;
const b = banners?.[page];
const caption = b ? tr(b.caption, lang) : '';
const place = b ? tr(b.place, lang) : '';
const credit = b ? tr(b.credit, lang) : '';
const toSrc = (f: string) => (/^https?:/.test(f) ? f : url(`/img/banners/${f}`));
const src = b?.image ? toSrc(b.image) : '';
// images: varias fotos lado a lado (tríptico) en lugar de una sola.
const many: any[] = b?.images ?? [];
---
{(b?.image || many.length > 0) && (
  <figure class:list={['banner', { full: b.full, multi: many.length > 0 }]}>
    {many.length > 0 ? (
      <div class="tiles" style={`--n: ${many.length}`}>
        {many.map((m: any) => <img src={toSrc(m.file)} alt={tr(m.alt, lang) ?? ''} style={`object-position: ${m.focus ?? 'center'}`} decoding="async" />)}
      </div>
    ) : (
      <img
        src={src}
        alt={tr(b.alt, lang) ?? ''}
        style={`object-position: ${b.focus ?? 'center'}`}
        decoding="async"
      />
    )}
    {(place || credit) ? (
      <figcaption class="wrap meta">
        {place && <span class="place"><Icon name="pin" size={14} />{place}</span>}
        {credit && <span class="credit" set:html={inline(credit)} />}
      </figcaption>
    ) : caption && <figcaption class="wrap" set:html={inline(caption)} />}
  </figure>
)}

<style>
  .banner { margin: 0; border-bottom: 1px solid var(--line); }
  .banner img { display: block; width: 100%; height: clamp(180px, 28vw, 340px); object-fit: cover; }
  .banner.full { border-bottom: 0; padding-top: 32px; }
  /* varias fotos: tríptico enmarcado dentro del ancho del contenido */
  .banner.multi { border-bottom: 0; padding-top: 32px; }
  .tiles {
    display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: 12px;
    width: min(var(--wrap) - 32px, calc(100% - 32px)); margin: 0 auto;
  }
  .banner .tiles img { height: clamp(150px, 26vw, 300px); border-radius: 4px 4px 0 0; }
  .banner.multi figcaption { max-width: var(--wrap); }
  @media (max-width: 560px) { .tiles { gap: 6px; } }
  .banner.full img { width: min(var(--wrap) - 32px, calc(100% - 32px)); height: auto; margin: 0 auto; object-fit: contain; border-radius: 4px; }
  .banner.full figcaption { max-width: var(--wrap); }
  .banner .meta {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 6px 20px;
    font-style: normal;
  }
  /* pie de foto: franja con línea ocre, pegada a la foto (igual en Proyectos, Actividad y Sobre mí) */
  .banner.full .meta, .banner.multi .meta {
    width: min(var(--wrap) - 32px, calc(100% - 32px)); margin: 0 auto; padding: 10px 14px;
    background: var(--surface); border-left: 3px solid var(--second); border-radius: 0 0 4px 4px;
  }
  .banner.full img { border-radius: 4px 4px 0 0; }
  .place { display: inline-flex; align-items: center; gap: 7px; font-size: 0.86rem; font-weight: 700; color: var(--ink); }
  .place :global(.icon) { color: var(--second); }
  .credit { font-size: 0.75rem; color: var(--muted); }
  .banner figcaption { padding-block: 8px; font-size: 0.8rem; font-style: italic; color: var(--muted); }
</style>
