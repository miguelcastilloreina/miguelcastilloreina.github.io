---
// Curvas de nivel generadas en el navegador detrás de la portada.
// Usan el color de acento, así que siguen la paleta y el modo oscuro.
---
<canvas class="contours" aria-hidden="true"></canvas>

<style>
  .contours { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; }
</style>

<script>
  function field(x: number, y: number) {
    const s = 2.1;
    return Math.sin(x * 0.011 + s) * Math.cos(y * 0.014 - s * 0.7)
      + 0.6 * Math.sin((x + y) * 0.007 + s * 1.3)
      + 0.35 * Math.cos(x * 0.023 - y * 0.017);
  }

  function draw(c: HTMLCanvasElement) {
    const r = c.getBoundingClientRect();
    if (!r.width || !r.height) return;
    const d = Math.min(window.devicePixelRatio || 1, 2);
    c.width = Math.round(r.width * d);
    c.height = Math.round(r.height * d);
    const g = c.getContext('2d');
    if (!g) return;
    g.setTransform(d, 0, 0, d, 0, 0);
    g.clearRect(0, 0, r.width, r.height);

    const step = 8;
    const cols = Math.ceil(r.width / step) + 1;
    const rows = Math.ceil(r.height / step) + 1;
    const f: number[][] = [];
    for (let j = 0; j < rows; j++) {
      f[j] = [];
      for (let i = 0; i < cols; i++) f[j][i] = field(i * step, j * step);
    }
    g.strokeStyle = getComputedStyle(document.documentElement).getPropertyValue('--accent').trim() || '#2c5e50';
    g.lineWidth = 1;

    for (let lv = -1.6; lv <= 1.8; lv += 0.22) {
      g.globalAlpha = lv > 1 ? 0.17 : 0.09;
      g.beginPath();
      for (let j = 0; j < rows - 1; j++) {
        for (let i = 0; i < cols - 1; i++) {
          const x = i * step, y = j * step;
          const v = [f[j][i], f[j][i + 1], f[j + 1][i + 1], f[j + 1][i]];
          const p = [[x, y], [x + step, y], [x + step, y + step], [x, y + step]];
          const pts: number[][] = [];
          for (let k = 0; k < 4; k++) {
            const a = v[k], b = v[(k + 1) % 4];
            if ((a < lv) !== (b < lv)) {
              const t = (lv - a) / (b - a);
              const [x1, y1] = p[k], [x2, y2] = p[(k + 1) % 4];
              pts.push([x1 + (x2 - x1) * t, y1 + (y2 - y1) * t]);
            }
          }
          if (pts.length >= 2) { g.moveTo(pts[0][0], pts[0][1]); g.lineTo(pts[1][0], pts[1][1]); }
          if (pts.length === 4) { g.moveTo(pts[2][0], pts[2][1]); g.lineTo(pts[3][0], pts[3][1]); }
        }
      }
      g.stroke();
    }
    g.globalAlpha = 1;
  }

  const canvases = document.querySelectorAll<HTMLCanvasElement>('canvas.contours');
  const redraw = () => canvases.forEach(draw);
  redraw();
  let t: number | undefined;
  window.addEventListener('resize', () => { clearTimeout(t); t = window.setTimeout(redraw, 150); });
  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', redraw);
  window.addEventListener('themechange', redraw);
</script>
