---
import '../styles/global.css';
import Icon from '../components/Icon.astro';
import { profile, url, tr, hasActivity, type Lang } from '../lib/data';
import { ui, href, type Route } from '../lib/i18n';

interface Props {
  lang: Lang;
  route?: Route;
  title?: string;
  description?: string;
}
const { lang, route, title, description } = Astro.props;
const t = ui[lang];
const other: Lang = lang === 'en' ? 'es' : 'en';
const institution = profile.institution;
const fullTitle = title ? `${title} · ${profile.name}` : `${profile.name} · ${institution}`;
const desc = description ?? t.metaDesc;
const canonical = new URL(Astro.url.pathname, Astro.site);
const navRoutes: Route[] = hasActivity ? ['research', 'projects', 'activity', 'about'] : ['research', 'projects', 'about'];
const switchHref = href(route ?? 'home', other);
const address: string[] = tr(profile.address, lang);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {route && (
      <>
        <link rel="alternate" hreflang="en" href={new URL(href(route, 'en'), Astro.site)} />
        <link rel="alternate" hreflang="es" href={new URL(href(route, 'es'), Astro.site)} />
        <link rel="alternate" hreflang="x-default" href={new URL(href(route, 'en'), Astro.site)} />
      </>
    )}
    <link rel="icon" href={url('/favicon.ico')} sizes="any" />
    <link rel="icon" href={url('/favicon-32.png')} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="manifest" href={url('/site.webmanifest')} />
    <link rel="sitemap" type="application/xml" href={url('/sitemap.xml')} />
    <meta name="theme-color" content="#2c5e50" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'es' ? 'es_CO' : 'en_US'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:image" content={new URL(url(`/img/og/card-${lang}.jpg`), Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name} · ${tr(profile.position, lang)}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={new URL(url(`/img/og/card-${lang}.jpg`), Astro.site)} />
    <meta name="twitter:site" content="@the3boy" />
    <meta name="google-site-verification" content="bcLE-6UWjjBjGBxhSg43R5VLBzQuZojC3mzDT8hgtQw" />
    <script is:inline>
      // Aplica el modo elegido antes de pintar la página (evita un destello del modo equivocado).
      try { var th = localStorage.getItem('theme'); if (th === 'light' || th === 'dark') document.documentElement.dataset.theme = th; } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <header class="bar">
      <div class="wrap">
        <a class="brand" href={href('home', lang)}>
          <img class="disc" src={url('/img/avatar.jpg')} alt="" width="36" height="36" />
          <span>{profile.name}</span>
        </a>
        <nav class="nav" aria-label={lang === 'es' ? 'Principal' : 'Main'}>
          {navRoutes.map((r) => (
            <a href={href(r, lang)} aria-current={route === r ? 'page' : undefined}>{t.nav[r]}</a>
          ))}
        </nav>
        <button type="button" class="theme-toggle" data-label-light={t.themeLight} data-label-dark={t.themeDark} aria-label={t.themeLight}>
          <Icon name="sun" size={15} class="i-sun" /><Icon name="moon" size={15} class="i-moon" />
        </button>
        <a class="lang-switch" href={switchHref} hreflang={other} lang={other} aria-label={t.otherLang}>
          <Icon name="globe" size={14} />{t.otherLangShort}
        </a>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap">
        <div>
          <div class="label">{t.contact}</div>
          <address class="contact">
            <strong class="who">{profile.name}</strong>
            <a class="row" href={`mailto:${profile.email}`}><Icon name="mail" /><span>{profile.email}</span></a>
            <span class="row"><Icon name="pin" /><span>{address.map((l, i) => (<>{l}{i < address.length - 1 && <br />}</>))}</span></span>
          </address>
        </div>
        <div>
          <div class="label">{t.elsewhere}</div>
          <ul class="plain">
            {profile.links.map((l: { label: string; url: string; icon?: string }) => (
              <li><a href={l.url} rel="me noopener"><Icon name={l.icon ?? 'web'} />{tr(l.label, lang)}</a></li>
            ))}
          </ul>
        </div>
        <p class="copy">© {new Date().getFullYear()} {profile.name}</p>
      </div>
    </footer>
    <script is:inline>
      (function () {
        var btn = document.querySelector('.theme-toggle');
        if (!btn) return;
        var root = document.documentElement;
        var mq = window.matchMedia('(prefers-color-scheme: dark)');
        var isDark = function () { return root.dataset.theme ? root.dataset.theme === 'dark' : mq.matches; };
        var label = function () { btn.setAttribute('aria-label', isDark() ? btn.dataset.labelLight : btn.dataset.labelDark); btn.title = btn.getAttribute('aria-label'); };
        label();
        btn.addEventListener('click', function () {
          var next = isDark() ? 'light' : 'dark';
          root.dataset.theme = next;
          try { localStorage.setItem('theme', next); } catch (e) {}
          label();
          window.dispatchEvent(new Event('themechange'));
        });
        mq.addEventListener('change', label);
      })();
    </script>
  </body>
</html>
